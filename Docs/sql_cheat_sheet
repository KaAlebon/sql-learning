⭐ SQL Cheat Sheet (Beginner → Analyst Level)
(Ready to paste into your repo as sql_cheat_sheet.md)

🔹 1. Basic SELECT
SELECT column1, column2
FROM table_name;

Useful patterns
SELECT * FROM table_name;          -- all columns
SELECT DISTINCT column FROM table; -- unique values

🔹 2. Filtering with WHERE
SELECT *
FROM table
WHERE column = 'value';

Operators
= equal

!= or <> not equal

> < >= <=

BETWEEN x AND y

IN (value1, value2)

LIKE '%text%' (contains)

LIKE 'text%' (starts with)

LIKE '%text' (ends with)

🔹 3. Sorting with ORDER BY
SELECT *
FROM table
ORDER BY column ASC;

SELECT *
FROM table
ORDER BY column DESC;

🔹 4. LIMIT / TOP
SQLite:
SELECT *
FROM table
LIMIT 10;

SQL Server:
SELECT TOP 10 *
FROM table;

🔹 5. JOINs
INNER JOIN
SELECT a.column, b.column
FROM tableA a
JOIN tableB b
  ON a.id = b.id;

LEFT JOIN
SELECT *
FROM tableA a
LEFT JOIN tableB b
  ON a.id = b.id;

RIGHT JOIN (not in SQLite)
SELECT *
FROM tableA a
RIGHT JOIN tableB b
  ON a.id = b.id;

FULL OUTER JOIN (not in SQLite)
SELECT *
FROM tableA a
FULL OUTER JOIN tableB b
  ON a.id = b.id;

🔹 6. Aggregations
SELECT
  COUNT(*) AS total_rows,
  SUM(column) AS total_value,
  AVG(column) AS average_value,
  MIN(column) AS smallest,
  MAX(column) AS largest
FROM table;

🔹 7. GROUP BY
SELECT column, COUNT(*)
FROM table
GROUP BY column;

GROUP BY + HAVING
SELECT driver_id, COUNT(*) AS deliveries
FROM deliveries
GROUP BY driver_id
HAVING COUNT(*) > 10;

🔹 8. CASE Statements
SELECT
  delivery_id,
  CASE
    WHEN delivery_time > expected_time THEN 'Late'
    ELSE 'On Time'
  END AS delivery_status
FROM deliveries;

🔹 9. Subqueries
SELECT *
FROM deliveries
WHERE driver_id IN (
    SELECT id
    FROM drivers
    WHERE experience_years > 5
);

Subquery in SELECT
SELECT
  driver_id,
  (SELECT AVG(rating)
   FROM reviews
   WHERE reviews.driver_id = drivers.id) AS avg_rating
FROM drivers;

🔹 10. Common Functions
Text
UPPER(column)

LOWER(column)

LENGTH(column)

SUBSTR(column, start, length)

Date
SQLite uses strftime:
SELECT strftime('%Y', delivery_date) AS year
FROM deliveries;

🔹 11. NULL Handling
SELECT COALESCE(column, 'Unknown')
FROM table;

🔹 12. Best Practice Query Structure
SELECT
    column1,
    column2,
    column3
FROM table_name
WHERE condition
GROUP BY column
HAVING condition
ORDER BY column
LIMIT 10;
