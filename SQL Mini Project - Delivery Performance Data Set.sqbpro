FROM main
LIMIT 10</sql><sql name="Late deliveries by drivers with more than 2 years experiance*">SELECT delivery_id, driver_id, experience_years
FROM main
LEFT JOIN Drivers on Driver=driver_name
Where status = 'Late' 
 and experience_years &gt;2
ORDER BY experience_years DESC
</sql><sql name="SQL 3*"></sql><current_tab id="2"/></tab_sql></sqlb_project>
